  "author": {
    "name": "Terahertz, Inc.",
    "email": "support@crosodo.com",
    "url": "https://crosodo.com"
  },
  "homepage": "https://crosodo.com",
  "repository": "https://github.com/Terahertz-Inc/crosodo-mcp",
  "license": "MIT",
  "keywords": [
    "crosodo",
    "cottage-food",
    "home-bakery",
    "permits",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "crosodo": {
          "trust": "untrusted"
        }
      }
    }
